# Supabase Connect > Session pooler. Copy each project's actual Host/User.
DB_HOST=CHANGE_ME_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.MONITOR_PROJECT_REF
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_SSLMODE=require
SECRET_KEY=CHANGE_ME_GENERATE_A_SEPARATE_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
EVENT_TOKEN=CHANGE_ME_SAME_RANDOM_TOKEN_IN_BOTH_FLASK_APPS
FRONTEND_ORIGIN=https://YOUR-MONITOR-WEB.onrender.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-monitor
APP_VERSION=day2-v1
ENABLE_SENTRY_TEST=false
PORT=5000
GENERAL_API_URL=https://YOUR-GENERAL-APP.onrender.com
